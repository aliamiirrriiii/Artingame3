{
  "name": "night-of-the-risen",
  "version": "1.0.0",
  "private": true,
  "description": "A wave-survival zombie shooter running in the browser on WebGL2 — physically based night rendering, flow-field horde AI, and a 12-weapon arsenal.",
  "type": "module",
  "scripts": {
    "start": "node serve.mjs",
    "assets": "node tools/fetch-assets.mjs",
    "assets:force": "node tools/fetch-assets.mjs --force",
    "smoke": "node tools/smoke.mjs",
    "test": "node tools/units.mjs",
    "touch": "node tools/touchtest.mjs",
    "apk": "cd android && ./gradlew assembleDebug",
    "verify:apk": "node tools/verify-apk.mjs",
    "models": "node tools/smoke.mjs --page tools/modelpreview.html --viewport 1280x420 --shot models.png"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.48.0",
    "three": "^0.180.0"
  }
}
